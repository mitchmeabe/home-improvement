{
  "name": "home-improvement",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm test && npm run typecheck && npm run sources:check && npm run markets:check && npm run evidence:check && npm run test:e2e:list",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "sources:check": "node scripts/source-audit.mjs",
    "sources:probe": "node scripts/source-audit.mjs --online",
    "markets:check": "node scripts/market-data-check.mjs",
    "test:e2e": "playwright test",
    "evidence:check": "node scripts/evidence-audit.mjs",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "next": "^15.5.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
